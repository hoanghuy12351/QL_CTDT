' Co cau to chuc - danh muc
khoa "1" *-- "0..*" boMon
khoa "1" *-- "0..*" nganh
boMon "0..1" o-- "0..*" nganh
nganh "1" *-- "0..*" chuyenNganh
coSo "1" *-- "0..*" phongHoc
khoaHoc "1" *-- "0..*" lop
nganh "1" o-- "0..*" lop
chuyenNganh "0..1" o-- "0..*" lop
coSo "0..1" o-- "0..*" lop

' Nguoi dung - giang vien - hoc phan
nguoiDung "0..1" -- "0..*" giangVien
boMon "0..1" o-- "0..*" giangVien
boMon "0..1" o-- "0..*" hocPhan
giangVien "1" -- "0..*" giangVienHocPhan
hocPhan "1" -- "0..*" giangVienHocPhan

' Chuong trinh dao tao
nganh "1" o-- "0..*" chuongTrinhDaoTao
boMon "0..1" o-- "0..*" chuongTrinhDaoTao
chuyenNganh "0..1" o-- "0..*" chuongTrinhDaoTao
khoaHoc "0..1" o-- "0..*" chuongTrinhDaoTao
chuongTrinhDaoTao "1" *-- "0..*" chuongTrinhHocPhan
hocPhan "1" o-- "0..*" chuongTrinhHocPhan
lop "1" -- "0..*" lopChuongTrinh
chuongTrinhDaoTao "1" -- "0..*" lopChuongTrinh
lop "1" *-- "0..*" tienDoHocPhanLop
chuongTrinhHocPhan "1" -- "0..*" tienDoHocPhanLop

' Ke hoach dao tao
namHoc "1" o-- "0..*" keHoachDaoTao
khoa "1" o-- "0..*" keHoachDaoTao
nguoiDung "0..1" -- "0..*" keHoachDaoTao
keHoachDaoTao "1" *-- "0..*" keHoachHocKy
hocKy "1" o-- "0..*" keHoachHocKy
keHoachDaoTao "1" *-- "0..*" tuanDaoTao
keHoachHocKy "0..1" o-- "0..*" tienDoHocPhanLop
namHoc "0..1" -- "0..*" tienDoHocPhanLop
hocKy "0..1" -- "0..*" tienDoHocPhanLop

' Ke hoach lop hoc phan - phan cong - lich day
keHoachHocKy "1" *-- "0..*" keHoachLopHocPhan
lop "1" o-- "0..*" keHoachLopHocPhan
hocPhan "1" o-- "0..*" keHoachLopHocPhan
chuongTrinhHocPhan "0..1" -- "0..*" keHoachLopHocPhan
keHoachLopHocPhan "1" *-- "0..*" nhomHocPhan
nhomHocPhan "1" *-- "0..*" phanCongGiangDay
giangVien "1" o-- "0..*" phanCongGiangDay
phanCongGiangDay "1" *-- "0..*" lichDayTheoTuan
tuanDaoTao "1" o-- "0..*" lichDayTheoTuan
phongHoc "0..1" o-- "0..*" lichDayTheoTuan

' Quy dinh va dinh muc
namHoc "0..1" o-- "0..*" quyDinhHeSoSiSo
namHoc "0..1" o-- "0..*" quyDinhTinhGio
giangVien "1" -- "0..*" dinhMucGiangVien
namHoc "1" -- "0..*" dinhMucGiangVien

